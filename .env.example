# Приложение
APP_NAME=gorkycode-assistant
ENVIRONMENT=local
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# База данных PostgreSQL
DATABASE_URL=postgresql+asyncpg://gorkycode:gorkycode@localhost:5432/gorkycode
DB_ECHO=false
AUTO_CREATE_TABLES=true

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CONVERSATION_HISTORY_TURNS=8

# GigaChat: Authorization key из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_TEMPERATURE=0.1
GIGACHAT_MAX_TOKENS=1024
GIGACHAT_VERIFY_SSL=true
# Путь к сертификату Минцифры, если он не установлен в системе
SBER_CA_BUNDLE=

# SaluteSpeech (синтез речи)
SBER_TTS_CREDENTIALS=
SBER_TTS_SCOPE=SALUTE_SPEECH_PERS
SBER_TTS_VOICE=Nec_24000
SBER_TTS_FORMAT=opus
# Синтез речи: auto — SaluteSpeech при наличии ключа, иначе локальный espeak-ng; sber/local/off
TTS_BACKEND=auto
# SaluteSpeech через Cloud.ru Foundation Models (WebSocket realtime): cloud > sber > local
CLOUD_TTS_API_KEY=
CLOUD_TTS_VOICE=Mer-Operator
LOCAL_TTS_ENABLED=true
LOCAL_TTS_BINARY=espeak-ng
LOCAL_TTS_VOICE=ru
LOCAL_TTS_SPEED=150

# Vosk (распознавание речи)
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22
FFMPEG_BINARY=ffmpeg
AUDIO_MAX_DURATION_SECONDS=120

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=hackathon_helperbot
ENABLE_TELEGRAM=true

# VK (сообщество-бот и мини-приложение)
VK_BOT_TOKEN=
VK_BOT_GROUP_ID=
VK_MINI_APP_ID=
VK_MINI_APP_SECRET=
# Сервисный ключ приложения: по нему подтягивается имя пользователя ВК
VK_ACCESS_TOKEN=
ENABLE_VK=true

# MAX
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_API_BASE_URL=https://platform-api2.max.ru
ENABLE_MAX=true

# Веб-интерфейс
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_PUBLIC_URL=http://localhost:8000
# Публичный адрес мини-приложения; пусто — берётся из WEB_PUBLIC_URL
MINI_APP_PUBLIC_URL=

# Сессии и коды привязки аккаунтов
# SESSION_SECRET обязателен в продакшене: им подписаны токены мини-приложений
SESSION_SECRET=change-me-in-production
SESSION_TTL_SECONDS=2592000
LINK_CODE_TTL_SECONDS=900

# Email OTP login (Resend: https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="GorkyCode <login@your-verified-domain.example>"
EMAIL_CODE_SECRET=replace-with-a-long-random-secret
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_COOLDOWN_SECONDS=60
# Демо-вход: этот адрес входит без письма в единый общий тестовый профиль.
# Пусто — демо-вход отключён.
DEMO_LOGIN_EMAIL=test@test.com

# Напоминания
ENABLE_SCHEDULER=true
REMINDER_POLL_SECONDS=30
REMINDER_LOOKAHEAD_SECONDS=60
